# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=production
LOG_LEVEL=info

# ─── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_here
JWT_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://fundscreditunion.vercel.app
PYTHON_API_URL=https://funds-credit-union-analytics.up.railway.app

# ─── Admin (role stored in DB; this email is used only for initial setup) ─────
ADMIN_EMAIL=fundscreditunion@gmail.com

# ─── Paystack (for external bank account name resolution) ─────────────────────
PAYSTACK_SECRET_KEY=sk_live_your_paystack_secret_key_here
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-your_flutterwave_secret_key_here

# ─── Brevo (for transactional emails — OTPs, credit alerts) ──────────────────
BREVO_API_KEY=your-brevo-api-key-here
BREVO_FROM_EMAIL=noreply@yourdomain.com
